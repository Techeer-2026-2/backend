# 이 파일을 .env 로 복사한 뒤 값을 채운다.  cp .env.example .env
# .env 는 절대 커밋하지 않는다 (.gitignore 에 포함됨).

# ---------- Spring ----------
SPRING_PROFILES_ACTIVE=local

# ---------- PostgreSQL ----------
POSTGRES_DB=commute_playlist
POSTGRES_USER=cp_user
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# ---------- 인증(JWT) ----------
# 운영(prod)에서 필수. 32바이트 이상의 무작위 값. 예) openssl rand -base64 48
# 로컬 실행은 비워 둬도 된다(application.yml 의 개발용 기본값 사용).
JWT_SECRET=

# ---------- 서버 포트 ----------
BACKEND_PORT=8080

# ---------- 외부 API ----------
# iTunes Search API 는 키가 필요 없다 (인증 불필요)
OPENWEATHER_API_KEY=
KAKAO_REST_API_KEY=
TMAP_APP_KEY=
