# 이 파일을 .env 로 복사한 뒤 값을 채운다.  cp .env.example .env
# .env 는 절대 커밋하지 않는다 (.gitignore 에 포함됨).

# ---------- Spring ----------
SPRING_PROFILES_ACTIVE=local

# ---------- PostgreSQL ----------
POSTGRES_DB=commute_playlist
POSTGRES_USER=cp_user
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# ---------- 서버 포트 ----------
BACKEND_PORT=8080

# ---------- 외부 API ----------
# iTunes Search API 는 키가 필요 없다 (인증 불필요)
OPENWEATHER_API_KEY=
KAKAO_REST_API_KEY=

# ---------- 음악 앱 일반 계정 ----------
# 운영에서는 필수: 32바이트 이상의 난수를 Base64로 인코딩한 값.
# 로컬에서 비워두면 재기동 시 토큰이 무효화되는 임시 키를 사용한다.
AUTH_JWT_SECRET_BASE64=
# 프론트엔드 주소를 쉼표로 구분. 운영에서는 실제 CloudFront 도메인으로 설정한다.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
